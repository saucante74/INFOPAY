ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# --- Authentication (single account) — see README.md, "Authentication" ---
ADMIN_USERNAME=admin
# bcrypt hash, never the password itself. Keep the SINGLE quotes: without
# them Docker Compose expands the `$` signs and truncates the hash.
ADMIN_PASSWORD_HASH='<output of the hash command in README.md>'
# At least 32 characters of randomness.
JWT_SECRET=replace-with-the-output-of-the-secret-command-in-README
# Optional, default 24.
JWT_EXPIRE_HOURS=170

# --- Rate limiting on /api/upload and /api/chat (each endpoint separately) ---
# Optional, default 20.
RATE_LIMIT_PER_HOUR=20

# --- Login rate limiting, per client IP (brute-force protection) ---
# Optional, default 5. Fixed 15-minute window.
LOGIN_RATE_LIMIT_PER_15MIN=5
